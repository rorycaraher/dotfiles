layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }
    pane size="75%" split_direction="vertical" {
        pane name="sandbox" size="40%" focus=true command="zsh" {
            args "-ic" "${SANDBOX:-rsbx}; exec zsh"
        }
        pane name="nvim" size="60%" command="nvim" {
            args "."
        }
    }
    pane name="terminal" size="25%"
}
