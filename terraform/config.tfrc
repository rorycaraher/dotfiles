# CLI config for terraform + opentofu (both point here via
# $TF_CLI_CONFIG_FILE / $TOFU_CLI_CONFIG_FILE, set in zsh/config/20-terraform.zsh).

# One shared provider download instead of one per project. After adding or
# bumping a provider: tofu providers lock -platform=linux_amd64 -platform=darwin_arm64
plugin_cache_dir = "$HOME/.terraform.d/plugin-cache"

# no upstream version-check calls
disable_checkpoint = true
