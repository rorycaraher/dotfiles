{
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f ~/.claude/skills/dumb/scripts/render.py && python3 ~/.claude/skills/dumb/scripts/render.py \"${CLAUDE_SESSION_ID}\" monitor || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "theme": "dark"
}
