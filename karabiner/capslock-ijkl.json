{
  "title": "Caps Lock: Escape (tap) / Arrow keys with IJKL (hold)",
  "rules": [
    {
      "description": "Caps Lock to Escape if alone, Ctrl if held; IJKL become arrows only while Caps Lock is physically held, so a real Ctrl+I/J/K/L (e.g. in vim) is untouched",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "caps_lock" },
          "to": [
            { "key_code": "left_control" },
            { "set_variable": { "name": "capslock_held", "value": 1 } }
          ],
          "to_after_key_up": [
            { "set_variable": { "name": "capslock_held", "value": 0 } }
          ],
          "to_if_alone": [{ "key_code": "escape" }]
        },
        {
          "type": "basic",
          "from": { "key_code": "i", "modifiers": { "mandatory": ["left_control"] } },
          "to": [{ "key_code": "up_arrow" }],
          "conditions": [{ "type": "variable_if", "name": "capslock_held", "value": 1 }]
        },
        {
          "type": "basic",
          "from": { "key_code": "k", "modifiers": { "mandatory": ["left_control"] } },
          "to": [{ "key_code": "down_arrow" }],
          "conditions": [{ "type": "variable_if", "name": "capslock_held", "value": 1 }]
        },
        {
          "type": "basic",
          "from": { "key_code": "j", "modifiers": { "mandatory": ["left_control"] } },
          "to": [{ "key_code": "left_arrow" }],
          "conditions": [{ "type": "variable_if", "name": "capslock_held", "value": 1 }]
        },
        {
          "type": "basic",
          "from": { "key_code": "l", "modifiers": { "mandatory": ["left_control"] } },
          "to": [{ "key_code": "right_arrow" }],
          "conditions": [{ "type": "variable_if", "name": "capslock_held", "value": 1 }]
        }
      ]
    }
  ]
}
